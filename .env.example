# Copiar a .env.local para probar en local (no se sube al repo).
# En producción se configuran en Vercel → Settings → Environment Variables (y redeploy).

# Dominio público (opcional: en Vercel se detecta solo con VERCEL_PROJECT_PRODUCTION_URL)
VITE_SITE_URL=

# Píxel de Meta: ID del Administrador de eventos (vacío = píxel desactivado)
VITE_META_PIXEL_ID=

# Verificación de dominio en Meta Business (solo el valor "content" de la etiqueta que da Meta)
VITE_META_DOMAIN_VERIFICATION=
